###############################################
# Authentication Endpoints
###############################################

### 1. Register New User
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "password123"
}

### 2. Login User
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### 3. Refresh Access Token (uses cookie automatically)
POST {{baseUrl}}/api/auth/refresh

### 4. Logout User
POST {{baseUrl}}/api/auth/logout

###############################################
# Category Endpoints (Requires Authentication)
###############################################

### 5. Get All Categories
GET {{baseUrl}}/api/categories
Authorization: Bearer {{accessToken}}

### 6. Get Category by ID
GET {{baseUrl}}/api/categories/1
Authorization: Bearer {{accessToken}}

###############################################
# Test Different Scenarios
###############################################

### Register with Invalid Email
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser2",
  "email": "invalidemail",
  "password": "password123"
}

### Register with Short Password
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser3",
  "email": "test3@example.com",
  "password": "123"
}

### Register with Existing Email
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "anotheruser",
  "email": "test@example.com",
  "password": "password123"
}

### Login with Wrong Password
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "wrongpassword"
}

### Access Categories Without Token (Should Fail)
GET {{baseUrl}}/api/categories

### Access Categories With Invalid Token
GET {{baseUrl}}/api/categories
Authorization: Bearer invalid_token_here

### Test 404 Route
GET {{baseUrl}}/api/nonexistent
